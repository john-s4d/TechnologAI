<?xml version="1.0" encoding="UTF-8"?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <endpoint>https://auth.technologai.com/client</endpoint>
    <generateAuthorizationHeader>true</generateAuthorizationHeader>
    <jwtAudience>&quot;https://auth.technologai.com/client&quot;</jwtAudience>
    <jwtFormulaSubject>$User.FederationIdentifier</jwtFormulaSubject>
    <jwtIssuer>https://technologai-dev-ed.develop.my.salesforce.com</jwtIssuer>
    <jwtSigningCertificate>technologai_agent</jwtSigningCertificate>
    <jwtValidityPeriodSeconds>60</jwtValidityPeriodSeconds>
    <label>ClientRegistration</label>
    <principalType>PerUser</principalType>
    <protocol>Jwt</protocol>
</NamedCredential>
